"ground": [Color(0.4, 0.44, 0.24, 1), Color(0.55, 0.5, 0.31, 1), Color(0.29, 0.24, 0.18, 1), Color(0.45, 0.38, 0.28, 1), Color(0.31, 0.29, 0.18, 1), Color(0.33, 0.26, 0.19, 1), Color(0.27, 0.22, 0.17, 1), Color(0.4, 0.32, 0.23, 1), Color(0.42, 0.4, 0.3, 1), Color(0.17, 0.15, 0.13, 1)],

photo_height = 125.0
photo_size = 175.0
intel_age = "знімок зроблено 5 год тому"
intel_estimate = "20–26 осіб"
intel_lines = PackedStringArray("Противник обладнав крайні садиби південного ряду: стрільба з вікон, проломи в стінах можливі.", "На південному краї — короткий окоп через дорогу й кулеметний ДЗОТ на західному фланзі; перед ними дріт.", "Дорога в хутір ймовірно замінована протитанковими мінами; поле перед хутором пристріляне мінометом.", "Цегляна хата на північному ряду проглядає всю вулицю й перехрестя.", "Розрахунок ПТРК у дворі східної садиби — техніку в полі буде уражено.", "Підходи: старий сад і городи на заході, неглибока балка на сході.", "Резерв противника (до двох груп, можливо з БМП) стоїть за хутором — після втрати позиції чекайте контратаку з півночі. Закріпіться в будинках і окопі, зберіть набої.", "Будинок займати й зачищати: «Тримати» / «Штурм» з ПКМ по будинку. Граната — у вікно чи двері, вхід через двері або пролом.")


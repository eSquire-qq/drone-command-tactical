[node name="Village" type="Node3D" unique_id=690884582]
script = ExtResource("1_unrpw")
map_id = "village"
budget_bonus = 250
extra_max = {
"assault_group": 1
}
title = "ХУТІР"
subtitle = "Опорний пункт у сільській забудові"
terrain_type = "Сільська забудова"
terrain_desc = "Район 260×260 м. Хутір на пологому підвищенні: два ряди хат уздовж головної вулиці, подвір'я з парканами й сараями, городи. Перед хутором ~80 м відкритого поля з вирвами. Захід: старий сад і городи — прихований підхід. Схід: неглибока балка до крайніх садиб. Дорога з півдня веде просто на перехрестя."
task_text = "Вибити противника з хутора: зачистити садиби південного ряду, захопити центр хутора й перехрестя — і втримати хутір 5 хв: противник контратакуватиме резервом із тилу."
size = 260.0
seed = 4417
relief = 0.6
base_heights = ExtResource("2_fbxfr")
environment = "village"
palette = {
"ambient": 0.55,
"crown": [Color(0.24, 0.31, 0.14, 1), Color(0.3, 0.35, 0.16, 1), Color(0.4, 0.38, 0.17, 1), Color(0.45, 0.33, 0.14, 1), Color(0.21, 0.27, 0.13, 1)],

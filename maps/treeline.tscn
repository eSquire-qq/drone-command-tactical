intel_estimate = "15–20 осіб"
intel_lines = PackedStringArray("Окопи повного профілю вздовж південного краю лісосмуги.", "Ймовірна кулеметна точка (ДЗОТ) на західному фланзі.", "У центрі лісосмуги — ймовірний бліндаж (можливий резерв).", "Перед окопами — колючий дріт і мінні загородження. Ймовірний прохід у центрі (противник ходить ним сам).", "Фланги прикриті окремими окопами; західна балка та поперечні посадки дають прихований підхід.", "Друга лінія окопів у глибині лісосмуги, тилова траншея за нею.", "Ймовірні розрахунки ПТРК — небезпечно для техніки на відкритій місцевості.", "Противник застосовує FPV-дрони по техніці та скупченнях піхоти.", "Працює РЕБ: низько підлетіти дроном до лісосмуги неможливо. РЕР пеленгує дрони, що довго висять у зоні РЕБ.")


[node name="Treeline" type="Node3D" unique_id=2023530923]
script = ExtResource("1_04he3")
map_id = "treeline"
title = "ПОСАДКА"
subtitle = "Опорний пункт противника в лісосмузі"
terrain_type = "Лісосмуга / поле"
terrain_desc = "Район 300×300 м. Відкрите поле ~70 м перед ворожою лісосмугою, посіченою обстрілами. Захід: балка з чагарником і поперечна лісосмуга — прихований підхід до флангу. Схід: дорога, хутір і ще одна поперечна посадка. Перед окопами — мінні загородження з проходами."
task_text = "Висунутися до лісосмуги, знищити або витіснити противника та захопити його позиції."

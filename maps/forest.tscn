intel_age = "знімок зроблено 5 год тому"
intel_estimate = "24–28 осіб"
intel_lines = PackedStringArray("Суцільний сосновий ліс: під деревами огляд 20–35 м, з дрона позиції під кронами видно погано. Техніка — лише дорогами й просіками.", "Перед траншеєю, ймовірно, секрет (2 особи) біля стежки.", "Траншея під деревами поперек масиву, перед нею дріт і протипіхотні міни, на кінці бліндаж.", "Західна просіка: ПТ-міни, на перехресті з лісовою дорогою — ДЗОТ із кулеметом. Поруч вирубка — відкрита й, імовірно, пристріляна.", "Східна просіка закрита засікою; за нею кулеметна траншея поперек просіки.", "Ціль — поляна з лісництвом: будинок (вогонь із вікон, можливо ПТРК), сараї з кулеметом, окоп на краю поляни, бліндаж. Резерв у бліндажах на півночі.", "Район висадки обирається на знімку: центр або одна з просік.")


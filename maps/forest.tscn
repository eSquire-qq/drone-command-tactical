[node name="Forest" type="Node3D" unique_id=716988303]
script = ExtResource("1_t35ux")
map_id = "forest"
title = "ЛІСОВИЙ МАСИВ"
subtitle = "Бій у сосновому лісі"
terrain_type = "Сосновий ліс, просіки, поляна"
terrain_desc = "Район 420×420 м, суцільний сосновий ліс: огляд під деревами 20–35 м, дрон бачить крізь крони погано. Техніка — лише лісовими дорогами й двома просіками (захід і схід). На заході — вирубка: відкрите місце, ймовірно пристріляне. На півночі — поляна з лісництвом, сараями й бліндажами."
task_text = "Пройти лісовий масив, збити передові позиції противника під деревами й захопити поляну з лісництвом."

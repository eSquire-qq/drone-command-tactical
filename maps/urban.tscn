[node name="Urban" type="Node3D" unique_id=2088840154]
script = ExtResource("1_efslp")
map_id = "urban"
title = "КВАРТАЛ"
subtitle = "Зимовий бій за міський квартал"
terrain_type = "Ліс, поля, посадка, міська забудова, зима"
terrain_desc = "Район 560×560 м під снігом. На півдні — наш ліс, далі поля зліва й справа і посадка по центру, що веде до міста; поля біля міста заміновані й пристріляні. Уздовж флангів і за містом — ліс із лісовими дорогами. Місто: приватний сектор на околиці, передній ряд обгорілих дев'ятиповерхівок (противника в них немає — їх можна зайняти), за 80–90 м — рубіж противника: три вежі з блокпостом, великий темний будинок праворуч, довгий будинок ліворуч; угорі — школа."
task_text = "Вийти до міста, зайняти будинки переднього ряду й, ведучи бій з їхніх вікон, захопити центр кварталу — три вежі та блокпост між ними."
size = 560.0
seed = 9177
relief = 0.35

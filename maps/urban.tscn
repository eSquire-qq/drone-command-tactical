}
photo_height = 320.0
photo_size = 560.0
intel_estimate = "23–28 осіб"
intel_lines = PackedStringArray("Від нашого лісу до міста — поля; по центру посадка. Поля біля міста під дротом і замінованими смугами, пристріляні мінометами.", "У посадці — секрет противника (2 особи) і траншея з кулеметом біля самого міста, поруч бліндаж.", "Передній ряд дев\'ятиповерхівок і приватний сектор на околиці — противника не виявлено. Їх можна зайняти й вести бій з вікон.", "Рубіж противника — за 80–90 м: три вежі з блокпостом між ними (ЦІЛЬ), великий темний будинок праворуч (ймовірно ПТРК), довгий будинок ліворуч.", "Школа з двома крилами на півночі — ймовірний резерв. Дев\'ятиповерхівки за вежами, ймовірно, порожні.", "Уздовж флангів і за містом — ліс із лісовими дорогами: довший, але прихований шлях. Район висадки обирається на знімку.", "Під\'їзди — з південного боку будинків. «Тримати» з ПКМ по будинку — зайняти вікна, «Штурм» — зачистити.")


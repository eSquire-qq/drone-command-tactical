script = ExtResource("1_rqbid")
map_id = "field"
budget_bonus = 400
extra_max = {
"fpv": 1,
"rifle_squad": 1
}
title = "ВИСОТА"
subtitle = "Опорний пункт на голому пагорбі"
terrain_type = "Відкрите поле"
terrain_desc = "Район 300×300 м. Голий пагорб висотою ~9 м з окопами по передньому схилу; перед ним ~120 м відкритого поля з вирвами. Схід: балка — неглибока прихована від висоти лощина до насосної станції. Захід: покинутий окоп, рядок тюків і далека посадка. Посеред поля — передова застава противника. Дорога веде просто на висоту."
task_text = "Перетнути відкрите поле, подавити й знищити противника на висоті та захопити її вершину."
size = 300.0
seed = 9031
relief = 0.7
base_heights = ExtResource("2_vtakt")
environment = "field"
palette = {

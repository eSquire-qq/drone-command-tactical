enemy_no_retreat = true
photo_height = 130.0
photo_size = 190.0
intel_age = "знімок зроблено 14 год тому"
intel_estimate = "12–16 осіб"
intel_lines = PackedStringArray("Завдання — лише розвідка: знайти й підтвердити дроном усі позиції. Піхота лишається на нашому рубежі.", "Ймовірний спостережний пост у гаю посеред поля.", "На зруйнованій фермі на сході — ймовірне кулеметне гніздо.", "Окоп під північною лісосмугою, перед ним дріт і міни.", "У глибині — бліндаж, балка на сході (можливі мінометники).", "Станція РЕБ десь у глибині; кожна група має переносний РЕБ — дрон, що підлітає низько, втрачає зв\'язок і може впасти.", "Запасного дрона немає. РЕР пеленгує дрон, що довго висить у зоні РЕБ, — противник відповідає мінометом по нашій лісосмузі.", "Підтверджує ціль лише чиста картинка: тримайтеся на відстані, набирайте висоту, використовуйте зум.")


"fog_density": 0.0011,
"grass": [Color(0.5, 0.5, 0.26, 1), Color(0.62, 0.56, 0.32, 1), Color(0.42, 0.44, 0.22, 1)],
"ground": [Color(0.45, 0.46, 0.25, 1), Color(0.6, 0.53, 0.32, 1), Color(0.3, 0.25, 0.18, 1), Color(0.47, 0.4, 0.29, 1), Color(0.32, 0.3, 0.19, 1), Color(0.34, 0.27, 0.19, 1), Color(0.27, 0.22, 0.17, 1), Color(0.42, 0.34, 0.24, 1), Color(0.44, 0.41, 0.3, 1), Color(0.17, 0.15, 0.13, 1)],
"sky_horizon": Color(0.7, 0.72, 0.7, 1),
